class Solution:
    def isBalanced(self, num: str) -> bool:
        a=[]
        b=[]
        for i in range(len(num)):
            if i % 2==0:
                a.append(num[i])
            else:
                b.append(num[i])
        w=sum(int(x) for x in a)
        c=sum(int(y) for y in b)
        if w==c:
            return True
        else:
            return False

        
