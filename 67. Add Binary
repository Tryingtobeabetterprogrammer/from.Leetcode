class Solution:
    def addBinary(self, a: str, b: str) -> str:
        r=""
        c=0
        a,b=a[::-1],b[::-1]
        for i in range(max(len(a),len(b))):
            
            
            d_a = 0
            d_b = 0

            if i < len(a):
                d_a = int(a[i])

            if i < len(b):
                d_b = int(b[i])

            t = d_a + d_b + c

            r = str(t % 2) + r

            c = t // 2

        if c:
            r='1'+r
        return r
