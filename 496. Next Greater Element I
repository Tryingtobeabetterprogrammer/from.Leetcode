class Solution:
    def nextGreaterElement(self, nums1: List[int], nums2: List[int]) -> List[int]:
        res=[]
        for i in nums1:
            if i in nums2:
                index = nums2.index(i)
                while True:
                    if index < len(nums2) - 1:
                        index += 1
                        if nums2[index] > i:
                            res.append(nums2[index])
                            break
                    else:
                        res.append(-1)
                        break
            else:
                res.append(-1)
        return res
