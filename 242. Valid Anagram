class Solution(object):
    def isAnagram(self, s, t):
        """
        :type s: str
        :type t: str
        :rtype: bool
        """
        if len(s)!=len(t):
            return False
        cs,ct={},{}
        for i in range(len(s)):
            cs[s[i]]=1+cs.get(s[i],0) #here cs[s[0]](a)=1+0 so a=1 again cs[s[2]](a)=1+1=2 so a=2
            ct[t[i]]=1+ct.get(t[i],0)
        for j in cs:
            if cs[j] != ct.get(j,0):
                return False
        return True 
        
